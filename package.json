{
  "name": "starter",
  "version": "1.0.0",
  "description": "Professional SCSS project",
  "main": "index.js",
  "scripts": {
    "sass:watch": "sass --watch sass:css --style expanded --source-map",
    "sass:build": "sass sass:css --style expanded --source-map",
    "postcss": "postcss css/main.css --use autoprefixer cssnano -o css/main.min.css",
    "build": "npm run sass:build && npm run postcss",
    "dev": "concurrently \"npm run sass:watch\"",
    "stylelint": "stylelint \"sass/**/*.scss\" --fix",
    "format": "prettier --write \"**/*.{js,json,html,css,scss}\""
  },
  "devDependencies": {
    "sass": "^1.83.1",
    "concurrently": "^9.1.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^11.0.0",
    "postcss-preset-env": "^9.3.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^12.0.0",
    "prettier": "^3.1.0"
  }
}